# Server port (Railway sets this automatically in production)
PORT=4000

# Cardmarket (MKM) API v2.0 credentials — https://www.cardmarket.com/en/Magic/Account/API
# Create a "Dedicated App" token pair for a server-to-server integration.
# When any of these are missing, the app automatically runs in DEMO MODE
# using deterministic mock pricing so the UI stays fully usable.
CARDMARKET_APP_TOKEN=
CARDMARKET_APP_SECRET=
CARDMARKET_ACCESS_TOKEN=
CARDMARKET_ACCESS_TOKEN_SECRET=

# Base URL for the Cardmarket API (rarely needs changing)
CARDMARKET_API_BASE_URL=https://api.cardmarket.com/ws/v2.0

# How long (seconds) Cardmarket API responses are cached in memory to stay
# within Cardmarket's daily request quota.
CARDMARKET_CACHE_TTL_SECONDS=300
